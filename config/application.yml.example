spring:
  application:
    name: opsflow
  # 默认不写 spring.profiles.active：
  # - 本地/外部 config 直接用本文件
  # - 打包 -Pdev/-Ptest/-Pprod 时由 jar 内 application.properties 注入
  # - 运行时也可通过 SPRING_PROFILES_ACTIVE 覆盖
  datasource:
    url: ${DB_URL:jdbc:mysql://127.0.0.1:3306/opsflow?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Shanghai}
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
  web:
    resources:
      static-locations: classpath:/static/
      add-mappings: true
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai

mybatis-plus:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.opsflow.dao.model
  configuration:
    map-underscore-to-camel-case: true

server:
  port: 8080

opsflow:
  license:
    enforcement-enabled: false
  pipeline:
    log-dir: ./data/pipeline-logs

logging:
  level:
    com.opsflow: DEBUG
    root: INFO
