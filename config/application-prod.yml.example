spring:
  application:
    name: opsflow
  datasource:
    url: ${DB_URL}
    username: ${DB_USERNAME:opsflow}
    password: ${DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
  web:
    resources:
      static-locations: classpath:/static/
      add-mappings: true
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai

mybatis-plus:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.opsflow.dao.model
  configuration:
    map-underscore-to-camel-case: true

server:
  port: 8080

opsflow:
  license:
    enforcement-enabled: false
  pipeline:
    log-dir: ./data/pipeline-logs

logging:
  level:
    com.opsflow: DEBUG
    root: INFO

