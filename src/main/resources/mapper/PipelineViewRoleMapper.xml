<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opsflow.dao.mapper.PipelineViewRoleMapper">

    <delete id="deleteByViewId">
        DELETE FROM pipeline_view_role WHERE view_id = #{viewId}
    </delete>

    <select id="selectRoleIdsByViewId" resultType="java.lang.Long">
        SELECT role_id FROM pipeline_view_role WHERE view_id = #{viewId}
    </select>

    <select id="selectViewIdsByRoleIds" resultType="java.lang.Long">
        SELECT DISTINCT view_id
        FROM pipeline_view_role
        WHERE role_id IN
        <foreach collection="roleIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
