pipeline {
    agent {
        label "${JENKINS_NODE}" // 使用参数指定的节点
    }
    
    environment {
        GIT_REPO = "${GIT_REPO}"
        GIT_BRANCH = "${GIT_BRANCH}"
        SERVICE_NAME = "${SERVICE_NAME}"
        SERVICE_CODE = "${SERVICE_CODE}"
        ENV_NAME = "${ENV_NAME}"
        HARBOR_PROJECT = "${HARBOR_PROJECT}"
        HARBOR_REGISTRY = "harbor.example.com" // 修改为你的Harbor地址
        K8S_NAMESPACE = "${K8S_NAMESPACE}"
        K8S_DEPLOYMENT = "${K8S_DEPLOYMENT}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "拉取代码: ${GIT_REPO} 分支: ${GIT_BRANCH}"
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${GIT_BRANCH}"]],
                    userRemoteConfigs: [[url: "${GIT_REPO}"]]
                ])
                sh 'git rev-parse HEAD > commit_id.txt'
            }
        }
        
        stage('Build') {
            steps {
                echo "构建服务: ${SERVICE_NAME}"
                sh "${BUILD_COMMAND}"
            }
        }
        
        stage('Build Docker Image') {
            steps {
                script {
                    def commitId = readFile('commit_id.txt').trim()
                    def imageTag = "${SERVICE_CODE}:${GIT_BRANCH}-${BUILD_NUMBER}-${commitId.take(7)}"
                    def imageFullName = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${imageTag}"
                    
                    echo "构建Docker镜像: ${imageFullName}"
                    sh """
                        docker build -f ${DOCKERFILE_PATH} -t ${imageFullName} .
                        docker push ${imageFullName}
                    """
                    
                    // 保存镜像Tag到文件，供后续步骤使用
                    writeFile file: 'image_tag.txt', text: imageTag
                    writeFile file: 'image_full_name.txt', text: imageFullName
                }
            }
        }
        
        stage('Deploy to K8s') {
            when {
                expression { "${AUTO_DEPLOY}" == "true" }
            }
            steps {
                script {
                    def imageTag = readFile('image_tag.txt').trim()
                    def imageFullName = readFile('image_full_name.txt').trim()
                    
                    echo "部署到K8s: ${K8S_NAMESPACE}/${K8S_DEPLOYMENT}"
                    sh """
                        kubectl set image deployment/${K8S_DEPLOYMENT} \
                            ${SERVICE_CODE}=${imageFullName} \
                            -n ${K8S_NAMESPACE}
                        
                        kubectl rollout status deployment/${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE} \
                            --timeout=300s
                    """
                }
            }
        }
    }
    
    post {
        success {
            echo "构建部署成功"
        }
        failure {
            echo "构建部署失败"
        }
        always {
            // 清理工作空间（可选）
            // cleanWs()
        }
    }
}

