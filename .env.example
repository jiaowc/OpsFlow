# 复制为 .env 后按需修改：
#   cp .env.example .env
# 然后：
#   ./scripts/deploy/compose-up.sh
# 或：
#   docker compose up -d --build

# ---------- 端口 ----------
OPSFLOW_PORT=8080
MYSQL_PORT=3306

# ---------- MySQL（Compose 内置库）----------
MYSQL_ROOT_PASSWORD=opsflow
MYSQL_PASSWORD=opsflow

# ---------- 应用 ----------
# 镜像名；不设则构建本地 opsflow:1.0.0
# OPSFLOW_DOCKER_IMAGE=opsflow:1.0.0

# JVM（容器内）
JAVA_OPTS=-Xms256m -Xmx512m

# 可选：Webhook 密钥（与 GitLab/GitHub Secret 一致）；为空则关闭
# OPSFLOW_WEBHOOK_SECRET=

# ---------- 仅外部数据库模式（docker-compose.app.yml）----------
# DB_URL=jdbc:mysql://host.docker.internal:3306/opsflow?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Shanghai
# DB_USERNAME=opsflow
# DB_PASSWORD=opsflow
